# ---------------------------------------------------------------------------
# SecureView — variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs pour votre environnement.
# ---------------------------------------------------------------------------

# --- Général ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Base de données ---
DATABASE_URL=postgresql://secureview:secureview@localhost:5432/secureview

# --- Redis (cache, sessions OTP, révocation, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Stockage S3 (Scaleway Object Storage en prod, MinIO en dev) ---
# Scaleway : endpoint du type https://s3.fr-par.scw.cloud, region fr-par
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_ACCESS_KEY_ID=secureview
S3_SECRET_ACCESS_KEY=secureview123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=secureview-documents
S3_BUCKET_PAGES=secureview-pages

# --- Chiffrement ---
# Master key AES-256 en base64 (32 octets). Génération : openssl rand -base64 32
# Sert à envelopper (wrap) la clé de chiffrement unique de chaque document.
MASTER_ENCRYPTION_KEY=

# --- Auth expéditeur (JWT) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- URLs signées de pages (viewer) ---
# Secret HMAC pour signer les URLs de pages filigranées. TTL fixé à 45s dans le code.
PAGE_URL_SIGNING_SECRET=

# --- OTP destinataire ---
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# --- Email (envoi des OTP) ---
# En développement, "console" affiche l'OTP dans les logs du serveur au lieu d'envoyer un email.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SecureView <no-reply@secureview.fr>"

# --- Rate limiting ---
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=600000
RATE_LIMIT_PAGE_MAX=120
RATE_LIMIT_PAGE_WINDOW_MS=60000

# --- Front ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
